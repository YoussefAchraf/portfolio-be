{
  "openapi": "3.0.3",
  "info": {
    "title": "et-be API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/v1",
      "description": "Versioned API base path (same convention as contracts/openapi)"
    }
  ],
  "paths": {
    "/hello": {
      "get": {
        "operationId": "showHello",
        "summary": "Boilerplate demo: greeting plus the most recent users read from the database",
        "tags": [
          "hello"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting and users (newest first)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      },
      "post": {
        "operationId": "createHello",
        "summary": "Boilerplate demo: store a greeting for the given name and answer \"hello <name>\"",
        "tags": [
          "hello"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHelloRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Greeting stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaidHelloResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/profile": {
      "get": {
        "operationId": "getPublicProfile",
        "summary": "Read the public profile and current CV",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: missing or invisible resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED: invalid input or cursor; details.fields maps fields to translation keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retry.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "fr"
              ],
              "default": "en"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "INVALID_CREDENTIALS",
              "FORBIDDEN",
              "CSRF_INVALID",
              "NOT_FOUND",
              "CONFLICT",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ]
          },
          "details": {
            "type": "object"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "firstname",
          "lastname",
          "roleName",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "roleName": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Greeting": {
        "type": "object",
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HelloResponse": {
        "type": "object",
        "required": [
          "message",
          "users",
          "greetings"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "hello"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "greetings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Greeting"
            }
          }
        }
      },
      "CreateHelloRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "example": "Ada"
          }
        }
      },
      "SaidHelloResponse": {
        "type": "object",
        "required": [
          "message",
          "greeting"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "hello Ada"
          },
          "greeting": {
            "$ref": "#/components/schemas/Greeting"
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "headline",
          "pitch",
          "about",
          "availability",
          "location",
          "portrait",
          "socialLinks",
          "seo",
          "cv"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "pitch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "about": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "portrait": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "alt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri-reference",
                "pattern": "^(https://|/[^/])",
                "maxLength": 2048
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "socialLinks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "email",
              "github",
              "linkedin"
            ],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 254
              },
              "github": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "linkedin": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048
              }
            }
          },
          "seo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "imageUrl"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 320
              },
              "imageUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048,
                "nullable": true
              }
            }
          },
          "cv": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "label"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2048
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "nullable": true
          }
        }
      },
      "CvVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "label"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "responses": {
      "ValidationFailed": {
        "description": "Request does not match the schema (code VALIDATION_FAILED, details.fields)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
