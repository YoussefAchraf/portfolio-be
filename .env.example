# Copy to .env and replace every secret. Local-development values only.
# Production: inject real values from the platform's secret store; never commit .env.
# Variables read today are validated by src/config/env.ts at boot (fail fast). Variables marked
# "(auth feature)" are reserved for it and not read yet.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false
REQUEST_BODY_LIMIT=100kb
# Demo routes (GET /v1/hello). Default: on, except NODE_ENV=production.
DEMO_ROUTES=true
# Insert the demo users at boot (idempotent). Default false.
SEED_DEMO_DATA=false
# Container only (docker/entrypoint.sh): apply Prisma migrations before starting. Default true.
MIGRATE_ON_START=true

# CORS / cookies
CORS_ORIGINS=http://localhost:3000
# true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# PostgreSQL (credentials must match the compose POSTGRES_* values below)
# Host ports of the compose postgres/redis (change both the port here AND in the URLs when 5432/6379 are taken).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/et_be

# Redis (auth feature: refresh tokens, rate limits)
REDIS_URL=redis://:changeme@localhost:6379/0

# Auth (auth feature)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Docker Compose only
POSTGRES_DB=et_be
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
PGADMIN_PASSWORD=local-only
