{
  "name": "et-be",
  "version": "1.0.0",
  "description": "Express TypeScript backend template (Clean Architecture, Prisma + PostgreSQL + Redis, Docker-ready)",
  "main": "dist/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest tests/unit tests/e2e --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --runInBand --passWithNoTests",
    "test:e2e": "jest tests/e2e --runInBand --passWithNoTests",
    "verify": "npm run lint && npm run check:policy && npm run docs:check && npm run typecheck && npm test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:provision-roles": "ts-node scripts/provisionDbRoles.ts",
    "db:seed": "ts-node scripts/seedDemoUsers.ts",
    "docs:export": "ts-node scripts/exportSwagger.ts",
    "docs:readme": "node scripts/docs-readme.mjs",
    "docs:check": "node scripts/docs-readme.mjs --check",
    "prepare": "node scripts/git-hooks.mjs install",
    "lock:sync": "node scripts/lock-sync.mjs",
    "check:policy": "node scripts/check-policy.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "effect": "^3.22.5",
    "minimatch": "^11.0.1"
  }
}
